<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
	<CodeSnippet Format="1.0.0">
		<Header>
			<Title>LineNumber</Title>
			<Shortcut></Shortcut>
			<Author>companyname, GTI</Author>
			<SnippetTypes>
				<SnippetType>Expansion</SnippetType>
			</SnippetTypes>
		</Header>
		<Snippet>
			<Code Language="PowerShell">
				<![CDATA[function Get-CurrentLine { $Myinvocation.ScriptlineNumber }]]>
			</Code>
		</Snippet>
	</CodeSnippet>
</CodeSnippets>
