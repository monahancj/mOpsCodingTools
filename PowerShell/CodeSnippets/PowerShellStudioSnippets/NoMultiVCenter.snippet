<?xml version="1.0"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
	<CodeSnippet Format="1.0.0">
		<Header>
			<Title>NoMultiVCenter</Title>
			<Author>companyname, GTI</Author>
			<SnippetTypes>
				<SnippetType>Expansion</SnippetType>
			</SnippetTypes>
		</Header>
		<Snippet>
			<Code Language="PowerShell"><![CDATA[if ( $global:DefaultVIServers.Count -gt 1 ) { throw "Sorry.  This doesn't support multiple vCenters yet" }]]></Code>
		</Snippet>
	</CodeSnippet>
</CodeSnippets>
