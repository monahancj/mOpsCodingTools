<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
	<CodeSnippet Format="1.0.0">
		<Header>
			<Title>OutputMessage</Title>
			<Shortcut></Shortcut>
			<Description>Standard format output message</Description>
			<Author>companyname, GTI</Author>
			<SnippetTypes>
				<SnippetType>Expansion</SnippetType>
			</SnippetTypes>
		</Header>
		<Snippet>
			<Code Language="PowerShell">
				<![CDATA[Write-Verbose -Message "$(Get-mNow)- $($MyInvocation.InvocationName) - Line $(Get-mCurrentLine) - output something useful"]]>
			</Code>
		</Snippet>
	</CodeSnippet>
</CodeSnippets>
